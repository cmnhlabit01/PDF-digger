# Google Gemini API Key (รับฟรีได้จาก https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# โมเดลเริ่มต้นที่ต้องการใช้งาน (เรียงลำดับ Fallback อัตโนมัติ: gemini-3.6-flash -> gemini-3.7-flash -> gemini-flash-latest -> gemini-3-flash-preview)
DEFAULT_MODEL=gemini-3.6-flash

# ฟอนต์เริ่มต้นสำหรับไฟล์ Word
DEFAULT_FONT=Cordia New
